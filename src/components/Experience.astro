---
import { experience } from '../data/experience';

const stats = [
  { value: '7+', label: 'Years' },
  { value: '6', label: 'Companies' },
  { value: '4', label: 'Sectors' },
];
---

<section
  id="experience"
  aria-labelledby="experience-heading"
  class="border-t border-line"
>
  <div class="mx-auto max-w-content px-5 md:px-8 py-20 md:py-32">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16 mb-12 md:mb-16">
      <div class="md:col-span-3">
        <h2
          id="experience-heading"
          class="text-[11px] tracking-[0.22em] uppercase text-subtle font-medium"
        >
          04 / Experience
        </h2>
      </div>
      <div class="md:col-span-9">
        <p class="font-display text-[clamp(1.4rem,3vw,2.1rem)] leading-[1.35] tracking-tightish text-ink max-w-3xl font-medium">
          A career built across six teams and four sectors.
        </p>

        <dl class="mt-8 md:mt-10 flex flex-wrap gap-x-10 gap-y-6">
          {stats.map((s) => (
            <div class="flex flex-col">
              <dt class="font-display text-[clamp(1.8rem,4vw,2.4rem)] leading-none tracking-tighter2 text-accent font-semibold">
                {s.value}
              </dt>
              <dd class="mt-1.5 text-[11px] tracking-[0.22em] uppercase text-subtle font-semibold">
                {s.label}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="grid md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-3"></div>

      <ol class="md:col-span-9 relative">
        {experience.map((entry, i) => (
          <li class="relative pl-6 md:pl-8 pb-12 last:pb-0 border-l border-line">
            <span
              class={`absolute -left-[5px] top-2 w-[9px] h-[9px] rounded-full ${i === 0 ? 'bg-accent ring-4 ring-accent/15' : 'bg-line'}`}
              aria-hidden="true"
            ></span>

            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-[12px] tracking-wide uppercase text-subtle font-medium">
              <span>{entry.start} &mdash; {entry.end}</span>
              <span class="text-line">·</span>
              <span>{entry.location}</span>
            </div>

            <h3 class="mt-2 font-display text-[20px] md:text-[22px] tracking-tightish text-ink font-semibold">
              {entry.company}
            </h3>
            <p class="mt-0.5 text-[14px] md:text-[15px] text-muted">
              {entry.role}
            </p>

            <p class="mt-3 text-[15px] md:text-[16px] text-muted leading-relaxed max-w-2xl">
              {entry.summary}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
