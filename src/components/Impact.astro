---
import { impactStats } from '../data/impact';
---

<section
  id="impact"
  aria-labelledby="impact-heading"
  class="border-t border-line"
>
  <div class="mx-auto max-w-content px-5 md:px-8 py-20 md:py-32">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16 mb-12 md:mb-16">
      <div class="md:col-span-3">
        <h2
          id="impact-heading"
          class="text-[11px] tracking-[0.22em] uppercase text-subtle font-medium"
        >
          02 / Impact
        </h2>
      </div>
      <div class="md:col-span-9">
        <p class="font-display text-[clamp(1.4rem,3vw,2.1rem)] leading-[1.35] tracking-tightish text-ink max-w-3xl font-medium">
          Measured in outcomes. Built across markets.
        </p>
      </div>
    </div>

    <dl class="grid grid-cols-2 md:grid-cols-3 gap-y-10 md:gap-y-14 gap-x-6 md:gap-x-10">
      {impactStats.map((s) => (
        <div class="flex flex-col">
          <dt class="font-display text-[clamp(2.2rem,5.5vw,3.6rem)] leading-none tracking-tighter2 text-accent font-semibold">
            {s.value}
          </dt>
          <dd class="mt-3 flex flex-col">
            <span class="text-[11px] tracking-[0.22em] uppercase text-subtle font-semibold">
              {s.label}
            </span>
            <span class="mt-1.5 text-[14px] md:text-[15px] text-muted leading-relaxed max-w-xs">
              {s.caption}
            </span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
